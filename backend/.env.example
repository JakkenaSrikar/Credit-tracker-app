# =====================================================================
# Kirana Shop Udhara Tracker — Backend Environment Configuration Example
# =====================================================================

# Database Configuration
DATABASE_URL=sqlite:///./udhara.db

# JWT Authentication Secret
JWT_SECRET=replace_with_strong_random_secret_in_production_2026

# Speech-to-Text (STT) Provider Configuration
# Supported providers: "groq", "openai", "mock"
SPEECH_PROVIDER=groq
SPEECH_API_KEY=your_groq_or_openai_api_key_here
SPEECH_MODEL=whisper-large-v3

# AI Transaction Extraction Configuration
# Supported providers: "rule_based" (default, free local NLP parser), "groq", "openai"
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Limits & Audio Controls
MAX_AUDIO_SIZE_BYTES=10485760
MAX_RECORDING_DURATION_SECONDS=30
VOICE_RATE_LIMIT_PER_MINUTE=30

PORT=8000
